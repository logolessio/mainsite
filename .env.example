AUTH_SECRET=generate with: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
ADMIN_EMAILS=you@example.com

# Stripe (use TEST mode keys first: Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=
# Webhook signing secret: Dashboard > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=

# Human check on sign-in (Cloudflare Dashboard > Turnstile > Add widget). The site key is public, the secret key is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The password for yt.logoless.io, the Side Effects channel plan (lib/yt/gate.ts). In production: wrangler secret put YT_PASSWORD
YT_PASSWORD=

# OMDb, for the film data on 17.logoless.io: only scripts/seventeen-omdb.mjs uses it
OMDB_API_KEY=
