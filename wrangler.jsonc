{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainsite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logoless",
      "database_id": "e981c32e-2e4a-4de0-a585-4485adbc96c8",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mainsite"
    }
  ],
  // The dev site. The same worker and database as the live site, so there is nothing to keep in sync: on this host every
  // feature is switched on and only admins can get in. Pushing a feature turns it on for logoless.io (see /admin/push).
  // logoless.io itself is attached to this worker in the Cloudflare dashboard, and is deliberately not listed here.
  "routes": [{ "pattern": "dev.logoless.io", "custom_domain": true }]
}
