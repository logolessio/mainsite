{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainsite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logoless",
      "database_id": "e981c32e-2e4a-4de0-a585-4485adbc96c8",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mainsite"
    }
  ],
  // The test copy of the site at dev.logoless.io. It has its own worker, its own database and its own secrets,
  // so nothing done there can touch real members or real money. Deploy it with: pnpm cf:deploy:dev
  "env": {
    "dev": {
      "name": "mainsite-dev",
      "vars": { "SITE_ENV": "dev" },
      "routes": [{ "pattern": "dev.logoless.io", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "logoless-dev",
          "database_id": "66a9ca3b-7eea-4679-8f65-1765ca052776",
          "migrations_dir": "migrations"
        }
      ],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "mainsite-dev" }]
    }
  }
}
