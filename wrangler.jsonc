{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainsite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logoless",
      "database_id": "e981c32e-2e4a-4de0-a585-4485adbc96c8",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mainsite"
    }
  ],
  // Both of the site's addresses are attached to this worker here. Wrangler treats this list as the complete set, so
  // logoless.io MUST stay in it: leaving it out takes the live site offline. Add new addresses; never remove this one.
  // The dev site is the same worker and database: on dev.logoless.io every feature is on and only the team gets in.
  // beta.logoless.io is the pre-launch sign-up (see lib/prelaunch.ts and middleware.ts): the one page open while the main site is shut behind the launch page.
  // scroll.logoless.io was the movie-trailers site and is gone. It stays attached only so the old link lands on the main site (see middleware.ts).
  // owner.logoless.io is the owner and admin dashboard, also the same worker (admin.logoless.io only forwards there). Pushing a feature turns it on for logoless.io (see /dev/features).
  // Every half hour the site looks again at the views of live submissions (each one only about every two hours: see lib/views-rescan.ts).
  // The scheduled handler itself is added to the built worker by scripts/patch-open-next.mjs.
  // Every minute the 30-second loop runs twice (Discord cards and channels, campaign numbers: see lib/discord/tick.ts). Each part
  // has a feature switch, so until a part is pushed a run only reads a few settings.
  "triggers": { "crons": ["*/30 * * * *", "* * * * *"] },
  "routes": [
    { "pattern": "logoless.io", "custom_domain": true },
    { "pattern": "dev.logoless.io", "custom_domain": true },
    { "pattern": "admin.logoless.io", "custom_domain": true },
    { "pattern": "owner.logoless.io", "custom_domain": true },
    { "pattern": "scroll.logoless.io", "custom_domain": true },
    { "pattern": "beta.logoless.io", "custom_domain": true }
  ]
}
